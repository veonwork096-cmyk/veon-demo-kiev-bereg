---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/global.css";
import rudaCyr from "../assets/fonts/ruda-cyrillic-wght-normal.woff2?url";
import logo from "../assets/brand/logo.svg";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={logo.src} type="image/svg+xml" />
    <link rel="preload" href={rudaCyr} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>

<style is:global>
  /* Floor 4 also on the page shell (the linter reads layouts separately from styles/). */
  html, body { overflow-x: clip; }
</style>
